{
  "name": "leobridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import tsx src/runtime/node.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/themes/komari/tsconfig.app.json",
    "test": "node --import tsx --test tests/*.test.ts web/themes/cfsm/tests/*.test.js web/themes/komari/tests/*.test.mjs",
    "build": "node scripts/build-frontend.mjs && node scripts/build-komari.mjs && node scripts/build-theme-bundles.mjs && esbuild src/runtime/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node.js",
    "check": "pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/node.js",
    "dev:worker": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "configure": "node --import tsx scripts/configure.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "configure:admin": "node --import tsx scripts/configure-admin.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:worker": "esbuild src/runtime/worker.ts --bundle --platform=browser --format=esm --outfile=dist/worker.js",
    "test:runtime": "node --import tsx --test tests/runtime-node.test.ts tests/runtime-single-port.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "acorn": "8.15.0",
    "chart.js": "4.4.8",
    "fflate": "0.8.2",
    "https-proxy-agent": "7.0.6",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "undici": "7.16.0",
    "uplot": "1.6.32",
    "uplot-react": "1.2.4",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.18",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.4.1",
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "wrangler": "4.45.0"
  },
  "license": "MIT"
}
