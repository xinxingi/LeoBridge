{
  "name": "leobridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import tsx src/runtime/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build-theme-bundles.mjs && esbuild src/runtime/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/node.js",
    "check": "pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build",
    "start": "node dist/node.js",
    "dev:worker": "wrangler dev",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "configure": "node --import tsx scripts/configure.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts",
    "configure:admin": "node --import tsx scripts/configure-admin.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build:worker": "esbuild src/runtime/worker.ts --bundle --platform=browser --format=esm --outfile=dist/worker.js",
    "test:runtime": "node --import tsx --test tests/runtime-node.test.ts tests/runtime-single-port.test.ts"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "fflate": "0.8.2",
    "https-proxy-agent": "7.0.6",
    "undici": "7.16.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.15.18",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.45.0"
  },
  "license": "MIT"
}
