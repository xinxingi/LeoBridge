# Copy to deploy/docker/.env, chmod 600, edit privately. Never commit it.
# There is no published LeoBridge image. This tag names YOUR local build.
LEOBRIDGE_IMAGE=leobridge:local
NODE_IMAGE=node:24-bookworm-slim
NGINX_IMAGE=nginx:1.28-alpine
TLS_DIRECTORY=/etc/leobridge/tls
BACKEND_SUBNET=172.30.84.0/24
BACKEND_DYNAMIC_RANGE=172.30.84.128/25
PROXY_IPV4=172.30.84.2
THEME_STORE_VOLUME=leobridge-theme-store

# All four hostnames must be distinct. Origins are derived as https:// by Compose.
BRIDGE_ADMIN_HOST=admin.example.com
BRIDGE_DISPLAY_HOST=monitor.example.com
BRIDGE_DISPLAY_DOMAIN=themes.example.com
BRIDGE_PREVIEW_HOST=preview.example.com

# Optional legacy source configuration; new installations use the management UI.
MMWX_BASE_URL=''
MMWX_PROBE_TOKEN=''
BRIDGE_TITLE='LeoBridge'
# Explicitly choose public or private; blank refuses Compose startup.
BRIDGE_ACCESS=''
# Separate viewer credentials required for private; otherwise leave empty.
BRIDGE_USERNAME=''
BRIDGE_PASSWORD=''
BRIDGE_ADMIN_USERNAME=admin
# Optional initial password (default: admin); first login requires a strong replacement.
# A custom initial password must be at least 20 characters; never reuse upstream token.
BRIDGE_ADMIN_PASSWORD=''
# Optional legacy bindings; new installations review and save these in the UI.
# Do not use array indices as IDs or regenerate existing IDs during migration.
BRIDGE_BINDINGS='[]'
BRIDGE_PING_TARGETS='{}'
