map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Docker's embedded DNS follows app container recreation. A shared upstream zone
# and `resolve` (nginx >= 1.27.3) avoid caching a dead app IP until nginx restarts.
resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 2s;
upstream leobridge_backend {
    zone leobridge_backend 64k;
    server app:8787 resolve;
}

# Unknown hosts do not redirect to an attacker-selected hostname.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
}
server {
    listen 80;
    server_name ${BRIDGE_ADMIN_HOST} ${BRIDGE_DISPLAY_HOST} ${BRIDGE_PREVIEW_HOST}
                *.${BRIDGE_DISPLAY_DOMAIN} *.${BRIDGE_PREVIEW_HOST};
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ${BRIDGE_ADMIN_HOST} ${BRIDGE_DISPLAY_HOST} ${BRIDGE_PREVIEW_HOST}
                *.${BRIDGE_DISPLAY_DOMAIN} *.${BRIDGE_PREVIEW_HOST};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    server_tokens off;
    # URLs may contain private server IDs; no access log by default.
    access_log off;
    error_log /dev/stderr warn;
    client_max_body_size 128k;

    location = /healthz { return 404; }

    location / {
        proxy_pass http://leobridge_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_redirect off;
    }
}
