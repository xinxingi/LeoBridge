[Unit]
Description=LeoBridge single-instance Node bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leobridge
Group=leobridge
WorkingDirectory=/opt/leobridge/current
Environment=NODE_ENV=production
Environment=BRIDGE_LISTEN_HOST=127.0.0.1
Environment=BRIDGE_LISTEN_PORT=8787
Environment=BRIDGE_THEME_STORE=./data
# Node parses this dotenv file; do not also load it with systemd EnvironmentFile.
Environment=BRIDGE_ENV_FILE=/opt/leobridge/current/runtime.env
ExecStart=/opt/leobridge/current/runtime/bin/node dist/node.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leobridge/current/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
